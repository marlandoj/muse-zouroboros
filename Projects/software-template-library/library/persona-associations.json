{
  "schemaVersion": 1,
  "associationVersion": "1.2.0",
  "catalogVersion": "1.0.0",
  "status": "validated",
  "owner": "Zouroboros Software Factory",
  "hashContract": {
    "version": "1.0.0",
    "algorithm": "sha256-canonical-json",
    "registryInput": "The complete schema-valid registry object, excluding the separately generated index, serialized as recursively key-sorted canonical JSON.",
    "associationInput": "associationVersion, catalogVersion, and one complete association object serialized as recursively key-sorted canonical JSON.",
    "output": "lowercase-hex-64"
  },
  "dispatchContract": {
    "version": "1.0.0",
    "defaultAuthority": "advise-review-only",
    "implementationAuthority": "A role that permits implement may implement only when an approved task explicitly sets authority=implement and supplies non-empty owned paths.",
    "identityResolution": "Resolve personaSelector.name by exact case-sensitive name against one live Zo list_personas directory snapshot immediately before dispatch.",
    "identityEvidence": "Record resolved UUID, exact current name, current scopes, association version and hash, and canonical directory snapshot hash.",
    "uuidPolicy": "Mutable persona UUIDs are forbidden in this registry and are retained only in dispatch evidence.",
    "routingIndependence": "Persona selection must not read or rewrite model policy, coding cascade, harness routing, or executor registry state.",
    "requiredFailurePolicy": "Missing, duplicate, renamed, unavailable, or under-scoped required personas fail closed before task dispatch in enforce mode.",
    "optionalFailurePolicy": "Every optional omission must retain a typed reason in task evidence.",
    "outputTrust": "Persona outputs are untrusted task inputs or review evidence; deterministic tests and factory gates retain final authority.",
    "modes": {
      "off": "Perform no persona directory call, add no persona fields, and preserve existing serialized state.",
      "shadow": "Resolve and retain would-invoke evidence without invoking personas or changing model, harness, executor, or task routing.",
      "enforce": "Invoke only operator-authorized roles within task authority, owned paths, phase, scope, and invocation-cap limits."
    }
  },
