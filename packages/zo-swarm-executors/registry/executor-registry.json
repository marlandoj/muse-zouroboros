{
  "$schema": "executor-registry/v1",
  "description": "Canonical supported CLI executor registry; services and deferred entries are not active CLI executors",
  "executors": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "executor": "local",
      "transport": "acp",
      "bridge": "packages/swarm/src/executor/bridges/claude-code-bridge.sh",
      "description": "Claude Code CLI in one-shot mode \u2014 full codebase context, file editing, terminal access",
      "expertise": [
        "code-generation",
        "code-review",
        "debugging",
        "refactoring",
        "architecture",
        "testing",
        "documentation"
      ],
      "best_for": [
        "Complex multi-file code changes",
        "Codebase-aware analysis requiring file reads",
        "Tasks needing terminal command execution",
        "Git operations and repository management"
      ],
      "config": {
        "defaultTimeout": 600,
        "model": "swarm-failover",
        "envVars": {
          "CLAUDE_CODE_BIN": "Path to claude binary (auto-detected if omitted)",
          "CLAUDE_CODE_MODEL": "Override model selection",
          "CLAUDE_CODE_TIMEOUT": "Timeout in seconds (default: 600)"
        }
      },
      "capabilities": {
        "fileRead": true,
        "fileWrite": true,
        "shellExec": true,
        "webResearch": false,
        "imageGen": false,
        "mcp": true,
        "streaming": true
      },
      "healthCheck": {
        "command": "command -v claude || test -x /root/.local/bin/claude",
        "expectedPattern": "claude",
        "description": "Verify Claude Code CLI is installed"
      },
      "acp": {
        "adapterBin": "claude-agent-acp",
        "modelSelection": {
          "method": "env",
          "envVar": "ANTHROPIC_MODEL"
        }
      },
      "sdk": {
        "ragCorpus": "claude-code-sdk",
        "package": "@anthropic-ai/claude-agent-sdk",
        "version": "0.3.220",
        "runtimeVersion": "2.1.220",
        "language": "typescript",
        "sourceType": "official-sdk",
        "reference": "packages/swarm/docs/executors/identities/claude-code.md",
        "surfaces": [
          "query-stream",
          "sessions",
          "mcp-servers",
          "custom-tools",
          "permissions",
          "hooks",
          "subagents",
          "structured-output"
        ],
        "runtimeStatus": "indexed-reference",
        "promotionRequired": true
      },
      "modelRouter": {
        "defaultModel": "claude-opus-5",
        "fallbackModel": "claude-haiku-4-5-20251001",
        "acceptedPrefixes": [
          "claude"
        ],
        "stripPrefixes": [
          "cc/"
        ],
        "tierMap": {
          "trivial": "claude-haiku-4-5-20251001",
          "simple": "claude-haiku-4-5-20251001",
          "moderate": "claude-opus-5",
          "complex": "claude-fable-5-1",
          "light": "claude-haiku-4-5-20251001",
          "mid": "claude-opus-5",
          "heavy": "claude-fable-5-1",
          "failover": "claude-haiku-4-5-20251001",
          "swarm-light": "claude-haiku-4-5-20251001",
          "swarm-mid": "claude-opus-5",
          "swarm-heavy": "claude-fable-5-1",
          "swarm-failover": "claude-haiku-4-5-20251001"
        }
      },
      "modelFamilies": [
        {
          "name": "anthropic-claude",
          "sourcePrefixes": [
            "anthropic/claude-"
          ],
          "stripPrefix": "anthropic/"
        }
      ],
      "modelPins": {
        "heavy": "claude-fable-5-1",
        "mid": "claude-opus-5",
        "light": "claude-haiku-4-5-20251001"
      }
    },
    {
      "id": "hermes",
      "name": "Hermes Agent",
      "executor": "local",
      "transport": "acp",
      "bridge": "packages/swarm/src/executor/bridges/hermes-bridge.sh",
      "description": "Hermes AI agent with tool-calling, web search, and multi-modal capabilities",
      "expertise": [
        "web-research",
        "web-scraping",
        "data-analysis",
        "image-generation",
        "multi-modal",
        "tool-orchestration",
        "audit",
        "review",
        "security",
        "summarize",
        "investigate"
      ],
      "best_for": [
        "Web research and content extraction",
        "Tasks requiring external API tools",
        "Image generation and analysis",
        "Multi-step tool-calling workflows",
        "Security audits and vulnerability assessment",
        "Content review and quality analysis",
        "Data gathering and summarization"
      ],
      "config": {
        "defaultTimeout": 300,
        "model": "swarm-failover",
        "envVars": {
          "HERMES_PROJECT_DIR": "Path to hermes-agent project (default: /home/zouroboros/hermes-agent)",
          "HERMES_VENV": "Path to venv activate script (default: $HERMES_PROJECT_DIR/.venv/bin/activate)",
          "HERMES_TIMEOUT": "Timeout in seconds (default: 300)",
          "HERMES_PROVIDER": "Optional provider override; defaults to the Hermes config",
          "SWARM_FALLBACK_PROVIDERS": "Optional comma-separated provider fallback chain",
          "KIMI_API_KEY": "Required when using the kimi-coding provider",
          "OPENROUTER_API_KEY": "Required when using the openrouter provider"
        }
      },
      "capabilities": {
        "fileRead": true,
        "fileWrite": true,
        "shellExec": true,
        "webResearch": true,
        "imageGen": true,
        "mcp": true,
        "streaming": true
      },
      "healthCheck": {
        "command": "hermes acp --check",
        "expectedPattern": "Hermes ACP check OK",
        "description": "Verify Hermes native ACP dependencies and adapter imports"
      },
      "acp": {
        "adapterBin": "hermes",
        "adapterArgs": [
          "acp",
          "--accept-hooks"
        ],
        "extraEnv": {
          "HERMES_AUTH_STORE_READ_ONLY": "1"
        },
        "mcpConfig": {
          "configPath": ".mcp.json",
          "includeShared": true,
          "includeZo": true,
          "includeMemoryBriefing": true
        },
        "modelSelection": {
          "method": "extension",
          "extensionMethod": "session/set_model",
          "category": "model",
          "providerSeparator": ":"
        },
        "endpointClass": "hermes-provider"
      },
      "transportFallback": {
        "envVar": "HERMES_ACP_ENABLED",
        "equals": "0",
        "transport": "bridge"
      },
      "sdk": {
        "ragCorpus": "hermes-sdk",
        "package": "hermes-agent",
        "version": "0.19.0",
        "runtimeVersion": "0.19.0",
        "sourceRevision": "live-git",
        "language": "python",
        "sourceType": "runtime-source",
        "reference": "packages/swarm/docs/executors/identities/hermes-agent.md",
        "surfaces": [
          "native-acp",
          "agent-loop",
          "toolsets",
          "mcp-transport",
          "provider-routing",
          "delegation",
          "session-memory",
          "scheduled-tasks"
        ],
        "runtimeStatus": "production-runtime",
        "promotionRequired": false
      },
      "modelFamilies": [
        {
          "name": "openrouter-agentic",
          "sourcePrefixes": [
            "anthropic/claude-",
            "openai/gpt-",
            "google/gemini-",
            "x-ai/",
            "z-ai/"
          ]
        }
      ],
      "modelRouter": {
        "passthrough": true,
        "fallbackModel": "claude-haiku-4-5-20251001",
        "defaultModel": "claude-opus-5",
        "tierMap": {
          "mid": "claude-opus-5",
          "light": "claude-haiku-4-5-20251001",
          "moderate": "claude-opus-5",
          "complex": "claude-fable-5-1",
          "simple": "claude-haiku-4-5-20251001",
          "trivial": "claude-haiku-4-5-20251001",
          "heavy": "claude-fable-5-1"
        }
      }
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "executor": "local",
      "transport": "acp",
      "bridge": "packages/swarm/src/executor/bridges/gemini-bridge.sh",
      "description": "Google Gemini CLI with persistent daemon \u2014 large-context reasoning, multimodal analysis, code generation. Daemon eliminates ~10s Node.js startup overhead per call.",
      "expertise": [
        "code-generation",
        "code-review",
        "reasoning",
        "multimodal",
        "large-context",
        "research",
        "prototyping",
        "analysis",
        "audit",
        "evaluate",
        "summarize",
        "compare"
      ],
      "best_for": [
        "Large-context code analysis (1M+ token window)",
        "Multimodal tasks involving images and documents",
        "Cross-validation and alternative perspective review",
        "Rapid prototyping and code generation",
        "Research synthesis across large corpora",
        "Comprehensive audit and evaluation tasks",
        "Summarization and comparison of complex findings"
      ],
      "config": {
        "defaultTimeout": 300,
        "model": "gemini-3.5-flash-lite",
        "envVars": {
          "GEMINI_MODEL": "Override model (e.g., gemini-3.8-flash for complex tasks)",
          "GEMINI_TIMEOUT": "Timeout in seconds (default: 300)",
          "GEMINI_NO_DAEMON": "Set to '1' to skip daemon and use direct CLI"
        }
      },
      "daemon": {
        "script": "Skills/zo-swarm-executors/scripts/gemini-daemon.ts",
        "socket": "/tmp/gemini-daemon.sock",
        "pidFile": "/tmp/gemini-daemon.pid",
        "logFile": "/dev/shm/gemini-daemon.log",
        "maxConcurrent": 4,
        "idleTimeout": "30min",
        "description": "Persistent HTTP daemon on Unix socket. Bridge auto-detects and routes through daemon. Falls back to direct CLI if daemon is down."
      },
      "warmUp": {
        "script": "Skills/zo-swarm-executors/scripts/gemini-warmup.ts",
        "hook": "Skills/zo-swarm-executors/scripts/pre-swarm-hook.sh",
        "recommended": "Run before swarm execution \u2014 starts daemon automatically (~12s \u2192 ~2s per call)"
      },
      "capabilities": {
        "fileRead": true,
        "fileWrite": true,
        "shellExec": true,
        "webResearch": true,
        "imageGen": false,
        "mcp": true,
        "streaming": true
      },
      "healthCheck": {
        "command": "command -v gemini",
        "expectedPattern": "gemini",
        "description": "Verify Gemini CLI is installed"
      },
      "acp": {
        "adapterBin": "gemini",
        "adapterArgs": [
          "--acp"
        ],
        "mcpConfig": {
          "configPath": ".mcp.json",
          "includeShared": true,
          "includeZo": false,
          "includeMemoryBriefing": true
        },
        "modelSelection": {
          "method": "env",
          "envVar": "GEMINI_MODEL"
        }
      },
      "sdk": {
        "ragCorpus": "gemini-cli-sdk",
        "package": "@google/gemini-cli-core",
        "version": "0.50.0",
        "runtimeVersion": "0.50.0",
        "language": "typescript",
        "sourceType": "official-runtime-core",
        "reference": "packages/swarm/docs/executors/identities/gemini-cli.md",
        "surfaces": [
          "agent-session",
          "content-generator",
          "tool-registry",
          "mcp-client",
          "policy-engine",
          "scheduler",
          "hooks",
          "skills",
          "sandbox"
        ],
        "runtimeStatus": "production-runtime",
        "promotionRequired": false
      },
      "modelRouter": {
        "defaultModel": "gemini-3.5-flash-lite",
        "fallbackModel": "gemini-3.5-flash-lite",
        "acceptedPrefixes": [
          "gemini",
          "models/"
        ],
        "stripPrefixes": [
          "gc/"
        ],
        "tierMap": {
          "trivial": "gemini-3.5-flash-lite",
          "simple": "gemini-3.5-flash-lite",
          "moderate": "gemini-3.8-flash",
          "complex": "gemini-3.8-flash",
          "light": "gemini-3.5-flash-lite",
          "mid": "gemini-3.8-flash",
          "heavy": "gemini-3.8-flash",
          "failover": "gemini-3.5-flash-lite",
          "swarm-light": "gemini-3.5-flash-lite",
          "swarm-mid": "gemini-3.8-flash",
          "swarm-heavy": "gemini-3.8-flash",
          "swarm-failover": "gemini-3.5-flash-lite"
        }
      },
      "modelFamilies": [
        {
          "name": "google-gemini",
          "sourcePrefixes": [
            "google/gemini-"
          ],
          "stripPrefix": "google/"
        }
      ]
    },
