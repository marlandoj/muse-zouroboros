{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zouroboros.ai/schemas/run-edge-proof-v1.schema.json",
  "title": "Zouroboros Run Edge Proof Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "record_id", "plan_id", "proof_id", "operation_id", "trace_id",
    "actor_hash", "verifier", "target_hash", "expected_state_hash", "observed_state_hash",
    "receipt_id", "receipt_hash", "terminal_event_id", "terminal_source_ref", "classification",
    "acknowledgement_tier", "timeliness", "observed_at", "source_revision", "provider_event_id",
    "payload_hash", "redaction", "predecessor_record_hash", "record_hash"
  ],
  "properties": {
    "contract_id": { "const": "zouroboros-edge-proof-record/v1" },
    "record_id": { "type": "string", "pattern": "^epr-[0-9A-F]{26}$" },
    "plan_id": { "type": "string", "pattern": "^epp-[0-9A-F]{26}$" },
    "proof_id": { "type": "string", "pattern": "^proof-[0-9A-F]{26}$" },
    "operation_id": { "type": "string", "pattern": "^op-[0-9A-HJKMNP-TV-Z]{26}$" },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "actor_hash": { "$ref": "#/$defs/hash" },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version", "identity_hash"],
      "properties": {
        "adapter": { "enum": ["github", "linear", "workspace"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "identity_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "target_hash": { "$ref": "#/$defs/hash" },
    "expected_state_hash": { "$ref": "#/$defs/hash" },
    "observed_state_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "receipt_id": { "type": "string", "pattern": "^rr-[0-9A-HJKMNP-TV-Z]{26}$" },
    "receipt_hash": { "$ref": "#/$defs/hash" },
    "terminal_event_id": { "type": "string", "pattern": "^evt-[0-9A-HJKMNP-TV-Z]{26}$" },
    "terminal_source_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "classification": { "enum": ["required", "notApplicable", "unavailable"] },
    "acknowledgement_tier": { "enum": ["none", "transport_accepted", "durable_confirmed", "user_visible_confirmed"] },
    "timeliness": { "enum": ["within_deadline", "late", "not_applicable"] },
    "observed_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "source_revision": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
    "provider_event_id": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
    "payload_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "raw_provider_response_persisted"],
      "properties": {
        "manifest": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "raw_provider_response_persisted": { "const": false }
      }
    },
    "predecessor_record_hash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "record_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
